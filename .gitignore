node_modules/
dist/
build/
coverage/
*.log
.env
.env.*
!.env.example
network/.env

# Fabric artefacts — regenerated, never committed
network/organizations/
network/channel-artifacts/
network/system-genesis-block/
*.tar.gz
*.block

# Key material — must never be committed under any circumstances
*.pem
*.key
!**/testdata/**/*.pem
security/keys/
secrets/

# Local state
vault/data/
.ledger-state.json
.DS_Store

# Agent tooling installed into the working tree by assistant sessions.
# Not part of the POC: it is local developer tooling that happens to live
# here, and committing it puts ~900K of unrelated skill definitions into a
# banking repository's history. The whole of .claude/ is local — skills,
# worktrees, per-machine settings and the dev-server config alike.
.agents/
.claude/
skills-lock.json

# Written documentation is internal to the programme and is not published
# with the code. The blueprint, the audits, the gap analysis, the readiness
# assessment and the demo runbook go to Compliance directly, not through a
# source repository. They remain on disk; they are simply not tracked here.
# README.md is the one document that ships with the code.
*.md
!README.md
