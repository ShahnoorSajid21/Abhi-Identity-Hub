# Local network credentials.
#
#   cp network/.env.example network/.env
#
# These are LOCAL DEVELOPMENT values. Production injects every one of them from
# HashiCorp Vault at deploy time — no credential is ever a literal in a compose
# file, a manifest or an image (finding SEC-09).
#
# network/.env is gitignored. If you find yourself wanting to commit it, that
# is the signal that the value belongs in a secret store instead.

COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me-locally

VAULT_DB_USER=vault
VAULT_DB_PASSWORD=change-me-locally
