# ABHI KYC Gateway — the crown-jewel service.
#
# Hardening choices are deliberate and each maps to a control in
# docs/SECURITY_AUDIT.md:
#   - distroless: no shell, so a shell-based exploit has nothing to invoke
#   - non-root:   uid 65532
#   - read-only root filesystem (enforced at runtime, see k8s manifest)
#   - no package manager, no curl, no wget in the final image

# ---- build ----------------------------------------------------------------
FROM node:22.15-bookworm-slim AS build
WORKDIR /build

COPY package.json package-lock.json* ./
COPY packages ./packages
COPY chaincode ./chaincode
COPY services ./services

# Deterministic install. --omit=dev because the gateway ships no dev tooling.
RUN npm ci --omit=dev --no-audit --no-fund 2>/dev/null || npm install --omit=dev --no-audit --no-fund

# ---- runtime --------------------------------------------------------------
#
# Debian 13 (trixie), not 12 (bookworm). The CI image scan blocks on CRITICAL
# and HIGH with ignore-unfixed, and the debian12 base carried six of them —
# all in the OS layer, none in this project's own packages, and all with fixes
# available upstream. Nothing here links against the base beyond Node itself:
# the gateway declares no runtime dependencies at all, so there is no native
# module to rebuild and the glibc move costs nothing.
FROM gcr.io/distroless/nodejs22-debian13:nonroot

WORKDIR /app
COPY --from=build --chown=nonroot:nonroot /build /app

USER nonroot:nonroot
EXPOSE 8080

ENV NODE_ENV=production \
    NODE_OPTIONS="--experimental-strip-types --max-old-space-size=512"

# The gateway refuses to boot with NODE_ENV=production unless a PKCS#11 HSM,
# the Fabric adapter and mTLS are configured. That refusal is intentional: it
# is what stops the POC configuration from silently becoming a deployment.
LABEL org.opencontainers.image.title="abhi-kyc-gateway" \
      org.opencontainers.image.vendor="ABHI Microfinance Bank" \
      org.opencontainers.image.source="https://github.com/ShahnoorSajid21/Abhi-Identity-Hub" \
      security.abhi.classification="crown-jewel"

# Core dumps disabled and swap off are host-level controls (see k8s manifest);
# they matter because this process holds plaintext attributes in memory.

ENTRYPOINT ["/nodejs/bin/node", "services/gateway/src/server.ts"]
