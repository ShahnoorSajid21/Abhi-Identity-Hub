{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [],
    "typeRoots": ["./node_modules/@types"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "types/**/*.d.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "chaincode/*/src/**/*.ts",
    "chaincode/*/test/**/*.ts",
    "services/*/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "**/dist"]
}
